{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DockStudio",
  "version": "2.0.5",
  "identifier": "com.dockstudio.app",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "cd ../web && npm run build",
    "beforeDevCommand": "cd ../web && npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DockStudio",
    "shortDescription": "跨平台分子对接平台",
    "longDescription": "DockStudio：跨平台（Windows/macOS/Linux）分子对接平台，简易五步向导 + 高级批量筛选模式。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/dockstudio-backend"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "DockStudio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  }
}
